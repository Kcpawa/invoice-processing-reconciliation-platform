# Copy to .env and adjust. Both services read this file.

# --- PostgreSQL (shared by Django and FastAPI) ---
DB_NAME=invoice_platform
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- FastAPI ---
MAX_UPLOAD_SIZE_MB=5
MAX_UPLOAD_ROWS=5000
STALE_BATCH_MINUTES=15
SQL_ECHO=False

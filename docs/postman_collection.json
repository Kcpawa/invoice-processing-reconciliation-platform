    {
      "name": "4. Bulk upload (FastAPI)",
      "item": [
        {
          "name": "Upload sample CSV",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{fastapi_url}}/api/v1/uploads/invoices",
              "host": [
                "{{fastapi_url}}"
              ],
              "path": [
                "api",
                "v1",
                "uploads",
                "invoices"
              ]
            },
            "description": "Choose samples/sample_invoices.csv. With the demo seed data the summary is 14 records: 6 success (4 matched + 2 mismatched), 7 failed, 1 duplicate. Sending the same file again returns HTTP 200 with idempotent_replay=true.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "sample_invoices.csv",
                  "description": "Select samples/sample_invoices.csv"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.summary) { pm.collectionVariables.set('batch_id', body.summary.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload sample XLSX",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{fastapi_url}}/api/v1/uploads/invoices",
              "host": [
                "{{fastapi_url}}"
              ],
              "path": [
                "api",
                "v1",
                "uploads",
                "invoices"
              ]
            },
            "description": "Same rows as the CSV. After the CSV was imported, the valid rows are reported as duplicates.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "sample_invoices.xlsx",
                  "description": "Select samples/sample_invoices.xlsx"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.summary) { pm.collectionVariables.set('batch_id', body.summary.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload with Idempotency-Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "upload-2026-11-21-001"
              }
            ],
            "url": {
              "raw": "{{fastapi_url}}/api/v1/uploads/invoices",
              "host": [
                "{{fastapi_url}}"
              ],
              "path": [
                "api",
                "v1",
                "uploads",
                "invoices"
              ]
            },
            "description": "Re-sending the same key + file replays the stored result. The same key with a different file is rejected with 409.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "sample_invoices.csv",
                  "description": "Select samples/sample_invoices.csv"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.summary) { pm.collectionVariables.set('batch_id', body.summary.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload again with force=true",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{fastapi_url}}/api/v1/uploads/invoices?force=true",
              "host": [
                "{{fastapi_url}}"
              ],
              "path": [
                "api",
                "v1",
                "uploads",
                "invoices"
              ],
              "query": [
                {
                  "key": "force",
                  "value": "true"
                }
              ]
            },
            "description": "Processes identical content again (e.g. after fixing master data). Rows already imported come back as DUPLICATE.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "sample_invoices.csv",
                  "description": "Select samples/sample_invoices.csv"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [

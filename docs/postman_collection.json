{
  "info": {
    "name": "Invoice Processing & Reconciliation Platform",
    "description": "Two services share one PostgreSQL database.\n\n* **Django REST Framework** (`{{django_url}}`, default http://localhost:8000) - vendors, purchase orders, invoices.\n* **FastAPI** (`{{fastapi_url}}`, default http://localhost:8001) - bulk upload, reconciliation, history, reports.\n\nSuggested order: run `python manage.py seed_demo_data` (or the *Create* requests below), then *Upload sample CSV*, then the reports. Create requests store the new id in a collection variable used by the following requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "django_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "fastapi_url",
      "value": "http://localhost:8001"
    },
    {
      "key": "vendor_id",
      "value": "1"
    },
    {
      "key": "po_id",
      "value": "1"
    },
    {
      "key": "invoice_id",
      "value": "1"
    },
    {
      "key": "batch_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. Vendors (Django)",
      "item": [
        {
          "name": "Create vendor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{django_url}}/api/v1/vendors/",
              "host": [
                "{{django_url}}"
              ],
              "path": [
                "api",
                "v1",
                "vendors"
              ]
            },
            "description": "vendor_code is unique (case-insensitive) and stored upper-case.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vendor_code\": \"V100\",\n  \"name\": \"Postman Demo Vendor\",\n  \"email\": \"ap@demo.example\",\n  \"phone\": \"+91-80-5550100\",\n  \"tax_id\": \"29POSTM1234A1Z5\",\n  \"address\": \"12 MG Road, Bengaluru\",\n  \"status\": \"ACTIVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.id) { pm.collectionVariables.set('vendor_id', body.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "List vendors",
